{
  "name": "restore-terminals-with-presets",
  "displayName": "Restore Terminals with presets",
  "description": "EthanSK's Restore terminal with some added features",
  "version": "1.2.0",
  "publisher": "Eyalhl",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/eyal-hl/restore-terminals-vscode/tree/new-ext"
  },
  "engines": {
    "vscode": "^1.46.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "restore-terminals.restoreTerminals",
        "title": "Restore Terminals"
      }
    ],
    "configuration": {
      "title": "Restore Terminals Config",
      "type": "object",
      "properties": {
        "restoreTerminals.runOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Whether or not to restore the terminals when VSCode starts up."
        },
        "restoreTerminals.keepExistingTerminalsOpen": {
          "type": "boolean",
          "default": false,
          "description": "Whether or not to keep any currently open terminals open when restoring."
        },
        "restoreTerminals.artificialDelayMilliseconds": {
          "type": [
            "number",
            "null"
          ],
          "default": 150,
          "description": "If you find restore terminals glitching out, or running some commands in the wrong window, you might want to try increasing this number to further delay the processing of actions. If you find it taking too long to open the terminal windows, you can try reducing this number, be be cautious as if it's too fast it will bug out."
        },
        "restoreTerminals.terminals": {
          "type": [
            "array",
            "object"
          ],
          "oneOf": [
            {
              "type": "object",
              "description": "Named presets - each preset can be an array of terminals or an object with keepExistingTerminalsOpen and terminals",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "array",
                    "description": "Legacy format: array of terminal windows",
                    "items": {
                      "properties": {
                        "setAsActive": {
                          "type": "boolean",
                          "description": "Whether to set this terminal as the active one after opening it."
                        },
                        "defaultSelected": {
                          "type": "boolean",
                          "description": "If exists on at least one terminal you will be able to choose if which terminals to run and which not, If its true it will be selected by default"
                        },
                        "splitTerminals": {
                          "type": "array",
                          "items": {
                            "properties": {
                              "name": {
                                "type": "string",
                                "description": "The name to give the terminal window"
                              },
                              "icon": {
                                "type": "string",
                                "description": "The icon to give the terminal window"
                              },
                              "commands": {
                                "type": "array",
                                "description": "The shell commands to execute when this terminal opens.",
                                "items": {
                                  "properties": {
                                    "type": "string",
                                    "description": "A shell command to run."
                                  }
                                }
                              },
                              "shouldRunCommands": {
                                "type": "boolean",
                                "description": "Whether to actually run the commands in the terminal, or just paste them there."
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "object",
                    "description": "Preset object with optional per-preset settings",
                    "properties": {
                      "keepExistingTerminalsOpen": {
                        "type": "boolean",
                        "description": "Whether or not to keep any currently open terminals open when restoring this preset. Overrides the global setting."
                      },
                      "terminals": {
                        "type": "array",
                        "description": "Array of terminal windows for this preset",
                        "items": {
                          "properties": {
                            "setAsActive": {
                              "type": "boolean",
                              "description": "Whether to set this terminal as the active one after opening it."
                            },
                            "defaultSelected": {
                              "type": "boolean",
                              "description": "If exists on at least one terminal you will be able to choose if which terminals to run and which not, If its true it will be selected by default"
                            },
                            "splitTerminals": {
                              "type": "array",
                              "items": {
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "description": "The name to give the terminal window"
                                  },
                                  "icon": {
                                    "type": "string",
                                    "description": "The icon to give the terminal window"
                                  },
                                  "commands": {
                                    "type": "array",
                                    "description": "The shell commands to execute when this terminal opens.",
                                    "items": {
                                      "properties": {
                                        "type": "string",
                                        "description": "A shell command to run."
                                      }
                                    }
                                  },
                                  "shouldRunCommands": {
                                    "type": "boolean",
                                    "description": "Whether to actually run the commands in the terminal, or just paste them there."
                                  }
                                },
                                "additionalProperties": false
                              }
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "terminals"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "type": "array",
              "items": {
                "properties": {
                  "setAsActive": {
                    "type": "boolean",
                    "description": "Whether to set this terminal as the active one after opening it."
                  },
                  "defaultSelected": {
                    "type": "boolean",
                    "description": "If exists on at least one terminal you will be able to choose if which terminals to run and which not, If its true it will be selected by default"
                  },
                  "splitTerminals": {
                    "type": "array",
                    "items": {
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "The name to give the terminal window"
                        },
                        "icon": {
                          "type": "string",
                          "description": "The icon to give the terminal window"
                        },
                        "commands": {
                          "type": "array",
                          "description": "The shell commands to execute when this terminal opens.",
                          "items": {
                            "properties": {
                              "type": "string",
                              "description": "A shell command to run."
                            }
                          }
                        },
                        "shouldRunCommands": {
                          "type": "boolean",
                          "description": "Whether to actually run the commands in the terminal, or just paste them there."
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.1",
    "@types/mocha": "^7.0.2",
    "@types/node": "^13.11.0",
    "@types/text-encoding": "^0.0.35",
    "@types/vscode": "^1.46.0",
    "@typescript-eslint/eslint-plugin": "^2.30.0",
    "@typescript-eslint/parser": "^2.30.0",
    "eslint": "^7.22.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "glob": "^7.1.6",
    "mocha": "^7.1.2",
    "prettier": "^2.2.1",
    "typescript": "^3.8.3",
    "vscode-test": "^1.3.0"
  },
  "dependencies": {
    "text-encoding": "^0.7.0"
  }
}
